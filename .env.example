COMPOSE_PROJECT_NAME=local-llm
# Raw `docker compose` uses both files by default. For CPU mode use only compose.yml.
COMPOSE_FILE=compose.yml:compose.cuda.yml

# Host paths
MODELS_DIR=./data/models
HOST_UID=1000
HOST_GID=1000

# Pinned upstream images
ANYTHINGLLM_IMAGE=mintplexlabs/anythingllm:1.15.0
CHROMA_IMAGE=chromadb/chroma:1.5.3
LLAMA_CPP_BASE_IMAGE=ghcr.io/ggml-org/llama.cpp:server-cuda-b10362
LLAMA_CPP_CUDA_IMAGE=ghcr.io/ggml-org/llama.cpp:server-cuda-b10362
LLAMA_CPP_CPU_IMAGE=ghcr.io/ggml-org/llama.cpp:server-b10362
LLAMA_ACCELERATOR=cuda
GPU_PREFLIGHT_IMAGE=nvidia/cuda:12.8.1-base-ubuntu24.04

# Hugging Face/model manager. Keep HF_TOKEN empty for public repositories.
HF_TOKEN=
DEFAULT_GGUF_PATTERN=*Q4_K_M*.gguf
ARIA2_CONNECTIONS=8
ARIA2_RETRIES=10
ARIA2_TIMEOUT=60
ARIA2_MIN_SPLIT_SIZE=16M
BOOTSTRAP_MODEL_REPO=
BOOTSTRAP_MODEL_PATTERN=

# Host ports
ANYTHINGLLM_PORT=3001
LLAMA_PORT=8080
AGENT_PORT=8000

# llama.cpp server (its internal Docker port remains 8080)
LLAMA_HOST=0.0.0.0
LLAMA_CONTEXT_SIZE=32768
LLAMA_GPU_LAYERS=auto
LLAMA_THREADS=
LLAMA_BATCH_SIZE=512
LLAMA_UBATCH_SIZE=256
LLAMA_FLASH_ATTN=on
LLAMA_JINJA=true
LLAMA_PARALLEL=1
LLAMA_MODEL_ALIAS=local-model
LLAMA_EXTRA_ARGS=
LLAMA_START_TIMEOUT=600

# AnythingLLM
ANYTHINGLLM_UID=1000
ANYTHINGLLM_GID=1000
ANYTHINGLLM_MODEL_PREF=local-model
ANYTHINGLLM_DISABLE_TELEMETRY=true

# Agent API
AGENT_LOG_LEVEL=INFO
AGENT_REQUEST_TIMEOUT=600

# MCP settings recovered from internet.sh/mcp_setup.sh
MCP_TIMEZONE=Asia/Kolkata
MCP_CORS_ORIGIN=http://localhost:3001
MCP_RESTART_DELAY=5

# Persistent memory
CHROMA_HOST=chroma
CHROMA_PORT=8000
CHROMA_COLLECTION=agent_memory
MEMORY_MCP_PORT=8011
